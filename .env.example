# Copy thành .env và chỉ điền các key cần cho workstream của bạn.
# Không commit .env hoặc secret thật.

# Shared application configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
TOP_K=5
SCORE_THRESHOLD=0.30
DATA_SNAPSHOT_ID=vinuni-public-2026-09-20

# Required for production embedding, query expansion, and generation.
# Offline tests use deterministic adapters and do not require this key.
OPENAI_API_KEY=

# Embedding: openai (the deterministic adapter is used automatically offline)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHROMA_COLLECTION=rag_documents
CHROMA_DIR=chroma_db

# Optional retrieval services; only the Retrieval owner needs these.
PAGEINDEX_API_KEY=
JINA_API_KEY=
