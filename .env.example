# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
TOP_K=5
SCORE_THRESHOLD=0.30
DATA_SNAPSHOT_ID=vinuni-public-2026-09-20
USE_HYBRID_RETRIEVAL=true
USE_LUNA_EXPANSION=false
USE_JINA_RERANKING=false

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHROMA_COLLECTION=rag_documents
CHROMA_DIR=chroma_db

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=
